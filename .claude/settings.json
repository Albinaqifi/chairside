{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/**/.env)",
      "Read(/.env.local)",
      "Read(/**/.env.local)",
      "Read(/.env.development)",
      "Read(/**/.env.development)",
      "Read(/.env.test)",
      "Read(/**/.env.test)",
      "Read(/.env.production)",
      "Read(/**/.env.production)",
      "Read(/.env.*.local)",
      "Read(/**/.env.*.local)",
      "PowerShell(*.env)",
      "PowerShell(*.env *)",
      "PowerShell(*.env.local*)",
      "PowerShell(*.env.development*)",
      "PowerShell(*.env.test*)",
      "PowerShell(*.env.production*)"
    ]
  }
}
