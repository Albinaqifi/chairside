# Dependencies
node_modules/

# Next.js build output and generated types (`next typegen` recreates them)
.next/
out/
next-env.d.ts

# Environment files: real values never go into git. `.env.example` is the template.
.env
.env.*
!.env.example

# Test and tool output
coverage/
*.tsbuildinfo

# Playwright's output (E00-T06b): traces and reports, which hold scripts, and the front desk's
# session that the end-to-end checks share.
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/.auth/

# Logs
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json
