# Copy this file to .env before running the project (PowerShell: Copy-Item .env.example .env).
#
# These values only work with the local Docker database from docker-compose.yml, which listens
# on this machine only and holds synthetic data. They are not secrets. Real secrets (staging,
# production) never go in this file or anywhere in git.

# Password of the `postgres` superuser in the local Docker database. Read by Docker Compose.
POSTGRES_PASSWORD=local-superuser-password

# Superuser connection. Used only by `pnpm db:reset` and the integration tests, to create the
# two roles below and to drop and recreate local databases.
DATABASE_ADMIN_URL=postgres://postgres:local-superuser-password@127.0.0.1:5433/postgres

# The migration role: runs migrations and owns the schema.
MIGRATION_DATABASE_URL=postgres://chairside_migrator:local-migrator-password@127.0.0.1:5433/chairside

# The app role: what the app connects as. It cannot bypass Row-Level Security or change the schema.
DATABASE_URL=postgres://chairside_app:local-app-password@127.0.0.1:5433/chairside

# Login (Better Auth, D-006). The secret signs the session cookie. This value is for the local app
# only and is not a secret; staging and production get their own random one, for example from
# `openssl rand -base64 32`, set on the host and never written down in git.
BETTER_AUTH_SECRET=WvmU7awnhS+hURz48Xzur7L/WDwpIn2OzurTHxKrCr0=

# The address the app is reached at. The only origin trusted for login requests. Cookies are
# marked Secure as soon as it starts with https://.
BETTER_AUTH_URL=http://localhost:3000
